# Phase 3 SLURM deployment sample (single-process, no Redis/Postgres required)

# Control plane
export BACKEND=slurm
export HOST=0.0.0.0
export PORT=8000
export APP_VERSION=0.6.0-m9

# Auth (required in token mode)
export AUTH_MODE=token
export OPERATOR_API_TOKEN=replace-with-operator-token
export AGENT_API_TOKEN=replace-with-agent-token

# SQLite + in-memory queue (Phase 3)
export DATABASE_URL=sqlite:///~/scheduler.db
export QUEUE_BACKEND=memory

# SLURM backend tuning
export SLURM_DEFAULT_PARTITION=gpu
export SLURM_LOG_DIR=~/scheduler-logs
export SLURM_SCRIPT_DIR=~/scheduler-scripts
export SLURM_POLLER_ENABLED=1
export SLURM_POLL_INTERVAL_SECS=15

# Control-plane callback URL used by generated sbatch scripts
# Set this to a routable URL from compute nodes to the control plane process.
export CONTROL_PLANE_CALLBACK_URL=http://127.0.0.1:8000
